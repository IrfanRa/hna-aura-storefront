# ===== H&A Aura — environment variables (NAMOONA) =====
# Ye file sirf sample hai. Asal values `.env.local` mein dalo
# (wo file git mein nahi jayegi — secrets mehfooz rahenge).

# (1) WooCommerce site ka address — build ke waqt products lane ke liye
WC_URL=https://peachpuff-gull-763326.hostingersite.com

# (2) WooCommerce REST API keys — sirf tumhare paas.
#     wp-admin → WooCommerce → Settings → Advanced → REST API se banti hain.
WC_KEY=apni_consumer_key_yahan_likho
WC_SECRET=apna_consumer_secret_yahan_likho

# (3) Site ka public address — browser wala code (checkout) isay use karta hai.
#     Ye secret NAHI hai (sab ko nazar ata hai).
NEXT_PUBLIC_WC_URL=https://peachpuff-gull-763326.hostingersite.com

# (4) Live site ka URL — sitemap aur canonical links ke liye.
#     Temp domain se asal domain par jate waqt sirf ye badalna.
NEXT_PUBLIC_SITE_URL=https://palegoldenrod-fish-444596.hostingersite.com
